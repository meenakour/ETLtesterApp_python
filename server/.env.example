# Copy this file to .env and fill in your own values. .env is gitignored -- never commit a real key.

# Shared Anthropic API key used by every user of the AI Assist feature. Keep this on the server
# only -- it is never sent to or read by the browser.
ANTHROPIC_API_KEY=

# Optional overrides
PORT=8787
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Restrict CORS to your deployed frontend's origin in production (defaults to "*" for local dev).
ALLOWED_ORIGIN=*
